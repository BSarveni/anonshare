# Railway auto-injects DATABASE_URL and REDIS_URL from Postgres/Redis plugins.
DATABASE_URL=postgresql+asyncpg://...
REDIS_URL=redis://...

SECRET_KEY=change_this_to_random_64_char_string
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=https://your-frontend.up.railway.app
# Railway: *.up.railway.app is also allowed via CORS regex (see main.py)
